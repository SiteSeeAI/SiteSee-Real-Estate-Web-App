{
  "date": "2026 09 19",
  "stage": "pricing_page_review",
  "pricing": {
    "page": "public/pricing.html",
    "legacy_page": "public/request-pricing-access.html",
    "address_gate": {
      "fields": [
        "street",
        "city",
        "state",
        "zip"
      ],
      "all_required": true,
      "behavior": "Explicit Continue button; invalidated address hides estimator and request fields."
    },
    "agent_fields": [
      {
        "name": "first",
        "required": true
      },
      {
        "name": "last",
        "required": true
      },
      {
        "name": "company",
        "required": true
      },
      {
        "name": "email",
        "required": true
      },
      {
        "name": "phone",
        "required": true
      },
      {
        "name": "optOut",
        "required": true
      }
    ],
    "mailing_list_opt_out": {
      "name": "optOut",
      "type": "select",
      "options": [
        "Yes",
        "No"
      ],
      "required": true,
      "default": null
    },
    "appointment": {
      "fields": [
        "date",
        "time"
      ],
      "required_for": "appointment request",
      "timezone": "America/Chicago",
      "confirmed": false
    },
    "subject": "Residential SiteSee Real Estate Quote",
    "subject_user_editable": false,
    "delivery": "mailto draft in visitor email app; self-copy or sales@sitesee.ai request",
    "automatic_delivery": false
  },
  "contact": {
    "preferred_communication": {
      "name": "preferred-communication",
      "label": "Preferred Communication",
      "type": "radio",
      "options": [
        "Call",
        "Text",
        "Email"
      ],
      "required": false,
      "default": null
    },
    "discovery_call_removed": true
  },
  "submission_enabled": false,
  "persistent_storage": false,
  "market_choice": {
    "name": "property-type",
    "required": true,
    "options": [
      "residential",
      "commercial"
    ],
    "initial": null,
    "behavior": "Separate hidden form panels; preserve selections within each market."
  },
  "commercial": {
    "fields": "Same required address, agent, preference and appointment fields as residential",
    "subject": "Commercial SiteSee Real Estate Quote",
    "license_default_months": 6,
    "license_max_months": 18,
    "extended_term_premium": "Custom quote pending approved schedule",
    "unlimited_photography_surcharge": 0.5,
    "unlimited_basis": "Property photography and aerial image fees only; exclude Matterport and non-photography services",
    "mixed_video_unlimited_license": "Custom quote",
    "matterport_rate_per_sqft": 0.1,
    "matterport_minimum": 199,
    "matterport_hosting_included_months": 6,
    "matterport_extended_hosting": "Separate quote, not automatically extended by the media license",
    "automatic_delivery": false
  }
}
